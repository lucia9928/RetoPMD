<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Estilo para el título (TextView) -->
    <!-- Estilo para el título (TextView) -->

    <!-- Estilo para los botones redondeados -->
    <style name="TitleTextStyle">
        <item name="android:textSize">36sp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAlignment">center</item>
    </style>
    <style name="SpinnerTextStyle">
        <item name="android:textColor">#000000</item> <!-- Color del texto dentro del Spinner -->
        <item name="android:textSize">16sp</item> <!-- Tamaño del texto -->
    </style>
    <!-- Estilo para los botones -->
    <style name="RoundedButtonStyle">
        <item name="android:layout_width">0dp</item> <!-- para que sea "match_constraint" en ConstraintLayout -->
        <item name="android:layout_height">60dp</item>
        <item name="android:background">@drawable/rounded_button</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>


