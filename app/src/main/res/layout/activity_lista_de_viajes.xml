<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ListaDeViajes">

    <TextView
        android:id="@+id/textViewListaViejes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/lista_de_viajes"
        android:textAlignment="center"
        android:textColor="#FFFFFF"
        android:textSize="36sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Reemplazo del botón de "Eliminar Viaje" por un ImageButton con un ícono de eliminar -->

    <Spinner
        android:id="@+id/spinner"
        android:layout_width="316dp"
        android:layout_height="56dp"
        android:layout_marginTop="88dp"
        android:background="@drawable/spinner_background"
        android:popupTheme="@style/SpinnerTextStyle"
        android:padding="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewListaViejes" />

    <ImageButton
        android:id="@+id/deleteButton"
        android:layout_width="109dp"
        android:layout_height="97dp"
        android:layout_marginStart="48dp"
        android:layout_marginTop="219dp"
        android:layout_marginEnd="44dp"
        android:layout_marginBottom="256dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/delete_trip"
        android:src="@drawable/delete"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/button2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/spinner" />

    <Button
        android:id="@+id/button2"
        android:layout_width="166dp"
        android:layout_height="94dp"
        android:layout_marginStart="44dp"
        android:layout_marginTop="215dp"
        android:layout_marginEnd="35dp"
        android:layout_marginBottom="256dp"
        android:text="Detalles del viaje"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/deleteButton"
        app:layout_constraintTop_toBottomOf="@+id/spinner" />
</androidx.constraintlayout.widget.ConstraintLayout>
