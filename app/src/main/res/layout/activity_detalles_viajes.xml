<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_gradient"
    tools:context=".DetallesViajes">

    <!-- Título -->
    <TextView
        android:id="@+id/textView"
        style="@style/TitleTextStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/titulo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp" />

    <!-- Campo de texto: Nombre -->
    <AutoCompleteTextView
        android:id="@+id/autoComTexNombre"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:hint="@string/nombre"
        android:backgroundTint="#FFFFFF"
        android:textColorHint="#FFFFFF"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView" />

    <!-- Campo de texto: Duración -->
    <AutoCompleteTextView
        android:id="@+id/autoComTextDuracion"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:hint="@string/duracion"
        android:backgroundTint="#FFFFFF"
        android:textColorHint="#FFFFFF"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/autoComTexNombre" />

    <!-- Botón: Imágenes -->
    <Button
        android:id="@+id/btnImagenes"
        style="@style/RoundedButtonStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/imgenes"
        android:layout_marginTop="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/autoComTextDuracion" />

    <!-- Botón: Videos -->
    <Button
        android:id="@+id/btnVideos"
        style="@style/RoundedButtonStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/videos"
        android:layout_marginTop="18dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnImagenes" />

    <!-- Botón: Audios -->
    <Button
        android:id="@+id/btnAudios"
        style="@style/RoundedButtonStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/audios"
        android:layout_marginTop="25dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnVideos" />

    <!-- Botón: Atrás -->
    <Button
        android:id="@+id/btnAtras"
        style="@style/RoundedButtonStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/atras"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="42dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnAudios"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
